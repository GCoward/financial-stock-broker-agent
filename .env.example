# Required environment variables for the Financial Stock Broker Agent.
# Copy this file to .env.local and fill in real values before running the app.
#
# ! CRITICAL: Never commit .env.local to source control.
#   Add it to .gitignore immediately.

# OpenAI API key – required for the BrokerAgent to function.
# Generate one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# JWT secret – must be a cryptographically random string of ≥32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Demo credentials – replace with a real database-backed authentication system.
# ! CRITICAL: These must NOT be used in production.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me

# AWS configuration – required for S3 log storage and DynamoDB user data.
# TODO: Migrate to AWS Secrets Manager for production deployments.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=financial-broker-agent-logs
